<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="30.0" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mikey.auction.javagui.seller.SellerListController">
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Sản phẩm của tôi" textFill="#1A202C">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label text="Quản lý và theo dõi các phiên đấu giá bạn đã đăng." textFill="#718096" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <FlowPane fx:id="sellerItemContainer" hgap="25.0" vgap="25.0" />
    </children>
</VBox>