<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.Pane?>
<VBox prefWidth="650.0" spacing="25.0"
      style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 40;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mikey.auction.javagui.user.UserController">

    <children>
        <Label text="Account Settings" textFill="#1A202C">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
        </Label>

        <HBox spacing="40.0">
            <children>
                <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox spacing="8.0">
                            <children>
                                <Label text="Your Username" textFill="#4A5568">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="usernameField" editable="false" prefHeight="45.0"
                                           style="-fx-background-color: #F7FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 15 0 15;"
                                           text="Anthony Webb" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Password" textFill="#4A5568">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                        <Pane HBox.hgrow="ALWAYS" />
                                        <Hyperlink onAction="#handleChangePassword" text="Change" textFill="#3182CE" style="-fx-underline: false; -fx-font-weight: bold;" />
                                    </children>
                                </HBox>
                                <TextField editable="false" prefHeight="45.0"
                                           style="-fx-background-color: #F7FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 15 0 15;"
                                           text="**********" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Hyperlink onAction="#handleDeleteAccount" text="Delete Your Account" textFill="#E53E3E">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                    <padding>
                                        <Insets left="-1.0" top="10.0" />
                                    </padding>
                                </Hyperlink>
                                <Label text="Mọi dữ liệu đấu giá và lịch sử của bạn sẽ bị xóa vĩnh viễn khỏi hệ thống."
                                       textFill="#718096" wrapText="true">
                                    <font>
                                        <Font size="11.5" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <VBox alignment="TOP_CENTER" spacing="15.0">
                    <children>
                        <Circle fill="#EDF2F7" radius="60.0" stroke="#CBD5E0" strokeType="INSIDE" />
                        <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="140.0"
                                style="-fx-background-color: #2D3748; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="Upload picture">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                    <padding>
                        <Insets top="10.0" />
                    </padding>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
            <children>
                <Button onAction="#cancelHandle" mnemonicParsing="false" prefHeight="45.0" prefWidth="120.0"
                        style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold;"
                        text="Cancel" />
                <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="120.0"
                        style="-fx-background-color: #2D3748; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold;"
                        text="Save Changes" />
            </children>
        </HBox>
    </children>
</VBox>