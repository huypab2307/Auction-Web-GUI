<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane stylesheets="@../style/Admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mikey.auction.javagui.admin.AdminController">
    
    <left>
        <VBox prefWidth="260.0" spacing="12" styleClass="sidebar">
            <Label styleClass="logo-text" text="AUCTION ADMIN" />
            <Region prefHeight="30.0" VBox.vgrow="NEVER" />
            
            <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#showDashboard" styleClass="nav-btn, active-btn" text="📊 Tổng quan hệ thống" />
            <Button fx:id="btnAuctionItems" mnemonicParsing="false" onAction="#showAuctionItems" styleClass="nav-btn" text="💎 Quản lý vật phẩm" />
            <Button fx:id="btnBiddingHistory" mnemonicParsing="false" onAction="#showBiddingHistory" styleClass="nav-btn" text="⚖ Lịch sử đặt giá" />
            <Button fx:id="btnUsers" mnemonicParsing="false" onAction="#showUsers" styleClass="nav-btn" text="👥 Quản lý Client" />
            <Region prefHeight="10.0" VBox.vgrow="ALWAYS" />
            
            <Button fx:id="btnSettings" mnemonicParsing="false" onAction="#showSettings" styleClass="nav-btn" text="⚙ Cài đặt Server" />
        </VBox>
    </left>

    <center>
        <BorderPane>
            <top>
                <HBox alignment="CENTER_RIGHT" prefHeight="70.0" spacing="20" styleClass="header">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Circle fx:id="serverStatusIndicator" radius="6.0" style="-fx-fill: #A1A5B7;" />
                        <Label fx:id="serverStatusLabel" styleClass="status-text" text="Server: Đang kết nối..." />
                    </HBox>
                    
                    <Region HBox.hgrow="ALWAYS" />
       
                    <TextField fx:id="searchField" promptText="Tìm kiếm mã phiên..." styleClass="search-box" />
                    <Label styleClass="icon-btn" text="🔔" />
                    <Label styleClass="user-profile" text="👤 Admin Quản Trị" />
                </HBox>
            </top>
            
            <center>
                <StackPane fx:id="contentStack">
                    <children>
                        
                        <VBox fx:id="viewDashboard" spacing="25" styleClass="main-content" visible="true">
                            <Label styleClass="page-title" text="Thống kê Phiên đấu giá" />
                      
                            <HBox spacing="25">
                                <VBox styleClass="card, card-blue" HBox.hgrow="ALWAYS">
                                    <Label styleClass="card-title" text="Phiên đang diễn ra" />
                                    <Label fx:id="lblActiveAuctions" styleClass="card-value" text="24" />
                                </VBox>
                                <VBox styleClass="card, card-green" HBox.hgrow="ALWAYS">
                                    <Label styleClass="card-title" text="Tổng giá trị giao dịch" />
                                    <Label fx:id="lblTotalVolume" styleClass="card-value" text="1,250,000,000 đ" />
                                </VBox>
                                <VBox styleClass="card, card-orange" HBox.hgrow="ALWAYS">
                                    <Label styleClass="card-title" text="Lượt trả giá mới" />
                                    <Label fx:id="lblNewBids" styleClass="card-value" text="342" />
                                </VBox>
                            </HBox>
           
                            <VBox spacing="10" VBox.vgrow="ALWAYS">
                                <Label styleClass="section-title" text="Danh sách vật phẩm đang đấu" />
                                <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="80.0" text="Mã Phiên" />
                                        <TableColumn fx:id="colItemName" prefWidth="250.0" text="Tên Vật Phẩm" />
                                        <TableColumn fx:id="colCurrentBid" prefWidth="180.0" text="Giá Cao Nhất Hiện Tại" />
                                        <TableColumn fx:id="colBidder" prefWidth="150.0" text="Client Đặt Giá" />
                                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Trạng Thái" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>
                        </VBox>

                        <VBox fx:id="viewAuctionItems" spacing="20" styleClass="main-content" visible="false">
                            <Label styleClass="page-title" text="Hệ thống quản lý vật phẩm" />
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <children>
                                    <TextField fx:id="searchItemField" promptText="Tìm kiếm tên vật phẩm..." styleClass="search-box" />
                                    <Button mnemonicParsing="false" onAction="#handleSearchItem" style="-fx-background-color: #0072FF; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;" text="Lọc dữ liệu" />
                                </children>
                            </HBox>
                            <TableView fx:id="itemTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colItemAucId" prefWidth="100.0" text="Mã Phiên" />
                                    <TableColumn fx:id="colItemTitle" prefWidth="280.0" text="Tên Sản Phẩm" />
                                    <TableColumn fx:id="colItemSeller" prefWidth="150.0" text="Người Đăng Bán" />
                                    <TableColumn fx:id="colItemStartPrice" prefWidth="160.0" text="Giá Khởi Điểm" />
                                    <TableColumn fx:id="colItemEndTime" prefWidth="210.0" text="Thời Gian Hết Hạn" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                        <VBox fx:id="viewBiddingHistory" spacing="20" styleClass="main-content" visible="false">
                            <Label styleClass="page-title" text="Toàn bộ lịch sử đặt giá hệ thống" />
                            <TableView fx:id="bidHistoryTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colHistBidId" prefWidth="120.0" text="Mã Giao Dịch" />
                                    <TableColumn fx:id="colHistAucId" prefWidth="120.0" text="Mã Phiên Đấu" />
                                    <TableColumn fx:id="colHistBidder" prefWidth="180.0" text="Tài Khoản Đấu" />
                                    <TableColumn fx:id="colHistAmount" prefWidth="200.0" text="Số Tiền Cược (đ)" />
                                    <TableColumn fx:id="colHistTime" prefWidth="250.0" text="Mốc Thời Gian Nhận Gói" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                        <VBox fx:id="viewUsers" spacing="20" styleClass="main-content" visible="false">
                            <Label styleClass="page-title" text="Quản lý danh sách tài khoản người dùng" />
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <children>
                                    <TextField fx:id="searchUserField" promptText="Nhập username cần tìm..." styleClass="search-box" />
                                    <Button mnemonicParsing="false" onAction="#handleSearchUser" style="-fx-background-color: #0072FF; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;" text="Tìm kiếm" />
                                </children>
                            </HBox>
                            <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colUserIdx" prefWidth="120.0" text="Mã số ID" />
                                    <TableColumn fx:id="colUserUsername" prefWidth="280.0" text="Tên đăng nhập" />
                                    <TableColumn fx:id="colUserRole" prefWidth="220.0" text="Vai trò hệ thống" />
                                    <TableColumn fx:id="colUserStatus" prefWidth="200.0" text="Trạng thái phân quyền" />
                                    <TableColumn fx:id="colUserAction" prefWidth="180.0" text="Hành động" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                        <VBox fx:id="viewSettings" spacing="25" styleClass="main-content" visible="false">
                            <Label styleClass="page-title" text="Cấu hình thông số Server Socket" />
                            <VBox maxWidth="550.0" spacing="18" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 3);">
                                <children>
                                    <Label styleClass="section-title" text="Cổng kết nối mạng lắng nghe (Server Port)" />
                                    <TextField fx:id="txtServerPort" style="-fx-background-color: #F4F7FC; -fx-background-radius: 8; -fx-padding: 12; -fx-font-weight: bold;" text="12345" />
                                    
                                    <Label styleClass="section-title" text="Số lượng Client tối đa cho phép kết nối cùng lúc" />
                                    <TextField fx:id="txtMaxConnections" style="-fx-background-color: #F4F7FC; -fx-background-radius: 8; -fx-padding: 12; -fx-font-weight: bold;" text="1000" />
                                    
                                    <Region prefHeight="15" />
                                    <HBox spacing="15">
                                        <children>
                                            <Button mnemonicParsing="false" onAction="#handleSaveSettings" style="-fx-background-color: linear-gradient(to right, #11998E, #38EF7D); -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 25; -fx-font-weight: bold; -fx-cursor: hand;" text="Lưu thông số ngầm" />
                                            <Button mnemonicParsing="false" onAction="#handleRestartServer" style="-fx-background-color: linear-gradient(to right, #FF9966, #FF5E62); -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 25; -fx-font-weight: bold; -fx-cursor: hand;" text="Khởi động lại Socket" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                        </VBox>

                    </children>
                </StackPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
