<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #f4f7fc;" stylesheets="@../style/Invoices.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mikey.auction.javagui.Invoices.MyInvoicesController">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-padding: 15 30 15 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <Button onAction="#handleBack" style="-fx-background-color: #e2e8f0; -fx-text-fill: #1a202c; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8 15;" text="🔙 Quay lại" />
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2b2b2b;" text="📦 ĐƠN HÀNG ĐÃ TRÚNG THẦU CỦA TÔI" />
        </HBox>
    </top>

    <center>
        <VBox style="-fx-padding: 30;">
            <TableView fx:id="invoiceTable" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 3);" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="100" style="-fx-alignment: CENTER;" text="Mã HĐ" />
                    <TableColumn fx:id="colAuctionId" prefWidth="150" style="-fx-alignment: CENTER;" text="Mã Phiên Đấu" />
                    <TableColumn fx:id="colAmount" prefWidth="250" style="-fx-alignment: CENTER-RIGHT;" text="Số Tiền Phải Trả" />
                    <TableColumn fx:id="colStatus" prefWidth="200" style="-fx-alignment: CENTER;" text="Trạng Thái" />
                    <TableColumn fx:id="colAction" prefWidth="200" style="-fx-alignment: CENTER;" text="Hành Động" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
