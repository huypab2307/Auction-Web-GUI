<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1200.0" style="-fx-background-color: #F4F7F6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mikey.auction.javagui.seller.SellerHubController">
    <top>
        <fx:include source="../topbar/topbar.fxml" fx:id="topBar" />
    </top>
    <left>
        <VBox prefWidth="240.0" spacing="10.0" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="30.0" />
            </padding>
            <children>
                <Label text="QUẢN LÝ BÁN HÀNG" textFill="#718096">
                    <font><Font name="System Bold" size="12.0" /></font>
                    <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                </Label>

                <ToggleButton fx:id="myAuctionsBtn" maxWidth="Infinity" onAction="#showMyAuctions" selected="true" style="-fx-background-color: #F7FAFC; -fx-text-fill: #2D3748; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" styleClass="toggle-blue-pastel" stylesheets="@../style/SellerToggleButton.css" text="📦 Sản phẩm đang bán">
                    <toggleGroup><ToggleGroup fx:id="sellerMenu" /></toggleGroup>
                    <font><Font name="System Bold" size="13.0" /></font>
                </ToggleButton>

                <ToggleButton fx:id="addAuctionBtn" maxWidth="Infinity" onAction="#showCreateAuction" style="-fx-background-color: transparent; -fx-text-fill: #4A5568; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" styleClass="toggle-blue-pastel" stylesheets="@../style/SellerToggleButton.css" text="➕ Thêm phiên đấu giá" toggleGroup="$sellerMenu">
                    <font><Font name="System Bold" size="13.0" /></font>
                </ToggleButton>

                <VBox VBox.vgrow="ALWAYS" /> <Button maxWidth="Infinity" onAction="#backToHome" prefHeight="40.0" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-background-radius: 8;" text="Quay lại Trang chủ">
                <font><Font name="System Bold" size="12.0" /></font>
            </Button>
            </children>
        </VBox>
    </left>
   <center>
      <ScrollPane fx:id="contentScrollPane" fitToWidth="true" prefHeight="200.0" prefWidth="200.0" stylesheets="@../style/scrollPane.css" BorderPane.alignment="CENTER">
        <content>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="200.0" prefWidth="200.0" />
        </content>
      </ScrollPane>
   </center>
</BorderPane>
